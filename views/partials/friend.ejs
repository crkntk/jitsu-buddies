<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div id= <%= friend %>-list class="bg-carbon-black py-3 my-1 px-2 text-white" type="button">
        <%= friend %>

    </div>
</body>
<script>
    
    $('#' + "<%=friend %>-list").on("click", async function(){
        var chat = $('#chat-sect-id [id]').map(function(){
            return this.id;
        }).get();
        var friendStr = "<%=friend %>";
        console.log(chat);
        console.log(friendStr);
        console.log(chat.includes(friendStr));
        if(chat.includes(friendStr) == false){
            let chatHtml = "<div id=<%=friend %> >
                 <%=friend %> 
                 </div>"
            $('#chat-sect-id').append(chatHtml);
        }
    });
</script>
</html>