<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div id= <%= friend %> class="bg-carbon-black py-3 my-1 px-2 text-white" type="button">
        <%= friend %>

    </div>
</body>
<script>
    
    $('#' + "<%=friend %>").on("click", async function(){
        if(<% currChatObj.has(friend) %>){
        let chatHtml = "<h3> <%=friend %> <h3>"
        $('#chat-sect-id').append(chatHtml);
        }
    });
</script>
</html>