<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div id=<%=friend %>-list class="flex flex-row bg-carbon-black py-3 my-1 px-2 text-white" type="button">
        <div><%= friend %> </div>
        <div id=<%=friend %>-icon class="bg-gray-400 w-[12px] h-[12px] rounded-4xl m-1.5 mx-3"> 
        </div>
        <div  id=<%=friend %>-text>: Offline</div>
    </div>
</body>
<script>
    
    $('#' + "<%=friend %>-list").on("click", async function(){
        var chat = $('#chat-sect-id [id]').map(function(){
            return this.id;
        }).get();
        var friendStr = "<%=friend %>";
        console.log(chat);
        console.log(friendStr);
        console.log(chat.includes(friendStr));
        if(chat.includes(friendStr) == false){
            let chatHtml = `<div
  id="<%= friend %>"
  class="bg-white text-black w-64 h-64 mx-1 border border-gray-200 rounded-xl shadow-md overflow-hidden flex flex-col"
>
  <!-- Header -->
  <div class="h-10 shrink-0 px-3 flex items-center border-b border-gray-200 bg-gray-50 relative">

    <h5 class="font-semibold text-sm truncate pr-8">
      <%= friend %>
    </h5>

    <!-- Close Button -->
    <button
      type="button"
      onclick="document.getElementById('<%= friend %>').remove()"
      class="absolute top-1/2 right-2 -translate-y-1/2 w-6 h-6 flex items-center justify-center rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-200 transition"
      aria-label="Close chat"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18 18 6M6 6l12 12"
        />
      </svg>
    </button>

  </div>


  <!-- Chat Messages -->
  <div
    id="<%= friend %>-chat"
    class="w-full flex-1 min-h-0 overflow-y-auto px-3 py-3 bg-white"
  >

    <ul class="space-y-3">

      <% if (typeof messages !== "undefined") { %>

        <% messages.forEach((message) => { %>

          <!-- Message from Friend -->
          <% if (message.sender === friend) { %>

            <li class="flex items-end gap-2 max-w-[90%]">

              <!-- Friend Avatar -->
              <div
                class="shrink-0 w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center"
              >
                <span class="text-xs font-semibold text-gray-600">
                  <%= friend.charAt(0).toUpperCase() %>
                </span>
              </div>

              <!-- Friend Message Bubble -->
              <div
                class="bg-gray-100 border border-gray-200 rounded-2xl rounded-bl-sm px-3 py-2"
              >
                <p class="text-xs text-gray-800 break-words">
                  <%= message.message %>
                </p>
              </div>

            </li>


          <!-- Message from Current User -->
          <% } else { %>

            <li class="flex justify-end">

              <div
                class="max-w-[80%] bg-blue-600 rounded-2xl rounded-br-sm px-3 py-2 shadow-sm"
              >
                <p class="text-xs text-white break-words">
                  <%= message.message %>
                </p>
              </div>

            </li>

          <% } %>

        <% }) %>

      <% } %>

    </ul>

  </div>


  <!-- Message Form -->
  <form
    id="<%= friend %>-form"
    method="get"
    class="w-full h-12 shrink-0 flex items-center gap-2 px-2 border-t border-gray-200 bg-gray-50"
  >

    <!-- Message Input -->
    <input
      id="<%= friend %>-input"
      name="submitted-name"
      autocomplete="off"
      type="text"
      placeholder="Type a message..."
      class="min-w-0 flex-1 h-8 px-3 text-xs bg-white border border-gray-300 rounded-lg outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
    />


    <!-- Send Button -->
    <button
      type="submit"
      class="w-16 h-8 shrink-0 rounded-lg bg-blue-600 text-white text-xs font-medium hover:bg-blue-700 active:bg-blue-800 transition"
    >
      Send
    </button>

  </form>

</div>`;
            $('#chat-sect-id').append(chatHtml);
            
            var chatForm = document.getElementById(friendStr + "-form");
            var input = document.getElementById(friendStr+'-input');
            chatForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const payload = {
                    recipientUsername: friendStr,
                    message: input.value,
                    timestamp: Date.now()
                };
                if (input.value) {
                    socket.emit('chat message', payload);
                    input.value = '';
                }
        });
        }
    });
</script>
</html>