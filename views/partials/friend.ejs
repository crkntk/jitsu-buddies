<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div id=<%=friend %>-list class="flex flex-row bg-carbon-black py-3 my-1 px-2 text-white" type="button">
        <div><%= friend %> </div>
        <div id=<%=friend %>-icon class="bg-gray-400 w-[12px] h-[12px] rounded-4xl m-1.5 mx-3"> 
        </div>
        <div  id=<%=friend %>-text>: Offline</div>
    </div>
</body>
<script>
    
    $('#' + "<%=friend %>-list").on("click", async function(){
        var chat = $('#chat-sect-id [id]').map(function(){
            return this.id;
        }).get();
        var friendStr = "<%=friend %>";
        console.log(chat);
        console.log(friendStr);
        console.log(chat.includes(friendStr));
        if(chat.includes(friendStr) == false){
            let chatHtml = `<div id=<%=friend %> class= "bg-white text-black w-64 mx-1 overflow-visible h-64"> 
                <h5> <%=friend %></h5>
                <form method="get">
                    <label>
                        Input
                        <input name="submitted-name" autocomplete="name" />
                    </label>
                    <button>Send</button>
                    </form>
                </div>`;
            $('#chat-sect-id').append(chatHtml);
        }
    });
</script>
</html>